---
---
<html lang="es" class="scroll-smooth bg-black">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CampusCast | Generación Espontánea</title>
  </head>
  <body class="bg-black text-white antialiased overflow-x-hidden">

    <!-- HERO SECTION -->
    <section class="h-screen flex flex-col justify-center items-center text-center p-4 relative z-10">
      <div class="inline-block px-3 py-1 mb-6 border border-neutral-800 rounded-full text-xs font-mono text-neutral-400 tracking-widest uppercase">
        AdvancedEPSG | Curso 2026-2027
      </div>
      <h1 class="text-7xl md:text-9xl font-extrabold tracking-tighter mb-4">
        CampusCast
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto mb-8 font-light">
        Infraestructura deportiva inteligente para el campus de Gandía. <br> Construida con residuo electrónico de la UPV.
      </p>
      <a href="#unete" class="bg-white text-black px-8 py-4 rounded-full font-bold hover:scale-105 transition-transform duration-300">
        Aplicar al equipo
      </a>
    </section>

    <!-- SECUENCIA DE SCROLL (VÍDEO + TEXTOS) -->
    <section id="scroll-sequence" class="relative h-[400vh] bg-black">
      <div class="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden">
        
        <video 
          id="tech-video" 
          src="/tech-bg.mp4" 
          class="absolute inset-0 w-full h-full object-cover opacity-40 mix-blend-screen"
          muted playsinline preload="metadata">
        </video>

        <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>

        <div class="relative z-10 text-center w-full max-w-4xl px-4">
          <h2 id="text-1" class="absolute w-full text-5xl md:text-7xl font-bold opacity-0 translate-y-10">
            Replay Instantáneo y VAR Universitario.
          </h2>
          <h2 id="text-2" class="absolute w-full text-5xl md:text-7xl font-bold opacity-0 translate-y-10">
            Visión Artificial en el Edge. <br><span class="text-3xl text-neutral-400 font-mono mt-4 block">YOLO26 + TrackNetV3 + OpenCV</span>
          </h2>
          <h2 id="text-3" class="absolute w-full text-5xl md:text-7xl font-bold opacity-0 translate-y-10 text-transparent bg-clip-text bg-gradient-to-r from-neutral-100 to-neutral-600">
            Buscamos ingenieros, no espectadores.
          </h2>
        </div>
      </div>
    </section>

    <!-- FORMULARIO TALLY -->
    <section id="unete" class="min-h-screen flex items-center justify-center p-4 bg-black border-t border-neutral-900 relative z-10">
      <div class="w-full max-w-2xl bg-neutral-950 p-8 rounded-2xl border border-neutral-900 shadow-2xl">
        <h2 class="text-3xl font-bold mb-2">Reclutando el Core Team</h2>
        <p class="text-neutral-500 mb-8">Buscamos perfiles para Redes/Servidores, Producción Audiovisual e Informática. Deja tus datos.</p>
        
        <!-- AQUÍ PEGAREMOS EL CÓDIGO DE TALLY -->
        <div id="tally-container" class="w-full">
           <iframe data-tally-src="https://tally.so/embed/68gQXO?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" loading="lazy" width="100%" height="1210" frameborder="0" marginheight="0" marginwidth="0" title="Campus Cast Inscription"></iframe>
			<script>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

        </div

      </div>
    </section>

    <!-- LÓGICA DE ANIMACIÓN -->
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      
      gsap.registerPlugin(ScrollTrigger);

      const video = document.getElementById("tech-video") as HTMLVideoElement;
      
      video.onloadedmetadata = () => {
        gsap.to(video, {
          scrollTrigger: {
            trigger: "#scroll-sequence",
            start: "top top",
            end: "bottom bottom",
            scrub: true,
          },
          currentTime: video.duration,
          ease: "none"
        });
      };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-sequence",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
        }
      });

      tl.to("#text-1", { opacity: 1, y: 0, duration: 1 })
        .to("#text-1", { opacity: 0, y: -50, duration: 1 }, "+=1")
        .to("#text-2", { opacity: 1, y: 0, duration: 1 })
        .to("#text-2", { opacity: 0, y: -50, duration: 1 }, "+=1")
        .to("#text-3", { opacity: 1, y: 0, duration: 1 })
        .to("#text-3", { opacity: 0, y: -50, duration: 1 }, "+=2");
    </script>
  </body>
</html>